        "#even and odd\n",
        "i = int(input(\"enter the numbers you want in your list: \"))\n",
        "list = []\n",
        "even = []\n",
        "odd = []\n",
        "for i in range(i):\n",
        "    num = int(input(\"Enter a number: \"))\n",
        "    list.append(num)\n",
        "for num in list:\n",
        "    if num % 2 ==0:\n",
