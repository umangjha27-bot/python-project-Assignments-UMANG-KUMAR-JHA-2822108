        "#max and min\n",
        "i = 0\n",
        "list = []\n",
        "while True:\n",
        "    num = int(input(\"Enter a number: \"))\n",
        "    list.append(num)\n",
        "    i += 1\n",
        "    if i >= 10:\n",
        "        break\n",
        "max = list[0]\n",
        "min = list[0]\n",
        "for i in range(0, len(list)):\n",
        "    if list[i] > max:\n",
        "        max = list[i]\n",
        "    if list[i] < min:\n",
        "        min = list[i]\n",
        "print(\"The maximum number is:\", max)\n",
        "print(\"The minimum number is:\", min)\n",
        "print(\"The list is:\", list)"
