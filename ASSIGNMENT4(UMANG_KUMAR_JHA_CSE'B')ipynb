        "#remove duplicate\n",
        "i = int(input(\"enter the numbers you want in your list: \"))\n",
        "list = []\n",
        "for i in range(i):\n",
        "    num = int(input(\"Enter a number: \"))\n",
        "    list.append(num)\n",
        "unique = []\n",
        "for num in list:\n",
        "    if num not in unique:\n",
        "        unique.append(num)\n",
        "print(\"The list is:\", list)\n",
        "print(\"The list without duplicates is:\", unique)"
